include README.md README.zh-CN.md LICENSE CITATION.cff RELEASE_STATUS.json
include CHANGELOG.md CONTRIBUTING.md SECURITY.md DEPLOYMENT_VERIFICATION.md AGENTS.md
include requirements-tested.txt .gitignore model.example.json
recursive-include packaging *
recursive-include .github/workflows *.yml
recursive-include docs *.md
recursive-include tests *.py
recursive-include tools *.py *.sh
recursive-include scripts *.py
recursive-include examples *.py *.md *.json
recursive-include verification *.json *.md
prune runs
prune work
prune inputs
prune .venv
prune acceptance-next
global-exclude *.pyc *.pyo *.sqlite *.sqlite-* *.db *.db-* *.log

prune docs/evolution
exclude docs/code_artifact.md docs/RELEASE_PREPARATION.zh-CN.md
